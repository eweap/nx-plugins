{
  "name": "@eweap/nx-workspace-tools",
  "version": "0.0.2-15",
  "type": "commonjs",
  "repository": {
    "url": "https://github.com/eweap/nx-plugins"
  },
  "homepage": "https://eweap.github.io/nx-plugins",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "executors.json",
    "generators.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@phenomnomnominal/tsquery": "^6.2.0",
    "lodash-es": "^4.17.21",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3"
  },
  "devDependencies": {
    "@nx/devkit": "^24.0.1",
    "@nx/js": "^24.0.1",
    "@nx/vue": "^24.0.1",
    "nx": "^24.0.1"
  },
  "peerDependencies": {
    "@nx/devkit": "^24.0.0",
    "@nx/js": "^24.0.0",
    "@nx/vue": "^24.0.0",
    "nx": "^24.0.0"
  },
  "nx": {
    "name": "nx-workspace-tools",
    "targets": {
      "build": {
        "executor": "@nx/js:tsc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/nx-workspace-tools/dist",
          "main": "packages/nx-workspace-tools/src/index.ts",
          "tsConfig": "packages/nx-workspace-tools/tsconfig.lib.json",
          "rootDir": "packages/nx-workspace-tools/src",
          "generatePackageJson": false,
          "assets": [
            {
              "input": "./packages/nx-workspace-tools/src",
              "glob": "**/!(*.ts)",
              "ignore": [
                "**/__snapshots__/**"
              ],
              "output": "."
            },
            {
              "input": "./packages/nx-workspace-tools/src",
              "glob": "**/*.d.ts",
              "output": "."
            }
          ]
        }
      }
    }
  },
  "executors": "./executors.json",
  "generators": "./generators.json"
}
